# Local Docker Compose defaults only. Replace these before any shared deployment.
POSTGRES_DB=pnw_chatbot
POSTGRES_USER=pnw_chatbot
POSTGRES_PASSWORD=local_dev_only
DATABASE_URL=postgresql+asyncpg://pnw_chatbot:local_dev_only@db:5432/pnw_chatbot

# Backend secrets; use unique, securely generated values outside local development.
SESSION_SECRET_KEY=replace-with-a-random-secret
WORKER_SHARED_SECRET=replace-with-a-random-secret
MODEL_PROVIDER_API_KEY=
OIDC_CLIENT_SECRET=

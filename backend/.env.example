# Backend runtime configuration. Secret values are intentionally placeholders.
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://pnw_chatbot:local_dev_only@localhost:5432/pnw_chatbot
SESSION_SECRET_KEY=replace-with-a-random-secret
WORKER_SHARED_SECRET=replace-with-a-random-secret

# Configure only with a university-approved provider and approved data-processing terms.
MODEL_PROVIDER=
MODEL_PROVIDER_API_KEY=

# Institutional OIDC reviewer sign-in configuration.
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
